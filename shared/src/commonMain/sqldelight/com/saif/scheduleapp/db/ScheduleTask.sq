CREATE TABLE scheduleTask (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    details TEXT NOT NULL,
    startMinutes INTEGER NOT NULL,
    endMinutes INTEGER NOT NULL,
    category TEXT NOT NULL,
    isDone INTEGER NOT NULL DEFAULT 0,
    repeatDays INTEGER NOT NULL DEFAULT 127,
    voiceEnabled INTEGER NOT NULL DEFAULT 1
);

CREATE TABLE taskCompletion (
    taskId INTEGER NOT NULL,
    date TEXT NOT NULL,
    PRIMARY KEY (taskId, date)
);

selectAll:
SELECT * FROM scheduleTask ORDER BY startMinutes ASC;

selectById:
SELECT * FROM scheduleTask WHERE id = :id;

setDone:
UPDATE scheduleTask SET isDone = :isDone WHERE id = :id;

insertTask:
INSERT INTO scheduleTask(title, details, startMinutes, endMinutes, category, isDone, repeatDays, voiceEnabled)
VALUES (:title, :details, :startMinutes, :endMinutes, :category, :isDone, :repeatDays, :voiceEnabled);

updateTask:
UPDATE scheduleTask
SET title = :title,
    details = :details,
    startMinutes = :startMinutes,
    endMinutes = :endMinutes,
    category = :category,
    repeatDays = :repeatDays,
    voiceEnabled = :voiceEnabled
WHERE id = :id;

deleteTask:
DELETE FROM scheduleTask WHERE id = :id;

lastInsertRowId:
SELECT last_insert_rowid();

insertCompletion:
INSERT OR REPLACE INTO taskCompletion(taskId, date)
VALUES (:taskId, :date);

deleteCompletion:
DELETE FROM taskCompletion
WHERE taskId = :taskId AND date = :date;

deleteCompletionsForTask:
DELETE FROM taskCompletion
WHERE taskId = :taskId;

selectCompletedTaskIdsForDate:
SELECT taskId FROM taskCompletion
WHERE date = :date;

selectCompletionsBetweenDates:
SELECT taskId, date FROM taskCompletion
WHERE date >= :fromDate AND date <= :toDate;

clearAllTasks:
DELETE FROM scheduleTask;

clearAllCompletions:
DELETE FROM taskCompletion;
