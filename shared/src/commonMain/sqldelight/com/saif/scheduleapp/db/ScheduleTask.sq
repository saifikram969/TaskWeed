CREATE TABLE scheduleTask (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    details TEXT NOT NULL,
    startMinutes INTEGER NOT NULL,
    endMinutes INTEGER NOT NULL,
    category TEXT NOT NULL,
    isDone INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE taskCompletion (
    taskId INTEGER NOT NULL,
    date TEXT NOT NULL,
    PRIMARY KEY (taskId, date)
);

selectAll:
SELECT * FROM scheduleTask ORDER BY startMinutes ASC;

setDone:
UPDATE scheduleTask SET isDone = :isDone WHERE id = :id;

insertTask:
INSERT INTO scheduleTask(title, details, startMinutes, endMinutes, category, isDone)
VALUES (:title, :details, :startMinutes, :endMinutes, :category, :isDone);

lastInsertRowId:
SELECT last_insert_rowid();

insertCompletion:
INSERT OR REPLACE INTO taskCompletion(taskId, date)
VALUES (:taskId, :date);

deleteCompletion:
DELETE FROM taskCompletion
WHERE taskId = :taskId AND date = :date;

selectCompletedTaskIdsForDate:
SELECT taskId FROM taskCompletion
WHERE date = :date;

clearAllTasks:
DELETE FROM scheduleTask;

clearAllCompletions:
DELETE FROM taskCompletion;
